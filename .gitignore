# ---------------------------------------------------------------------------
# Comfyui-Krea2-Portrait-V3 · 不随仓库分发的文件
#
# 原则：**仓库只放运行插件必需的代码与文档**；本机数据、抓取缓存、
#      开发期测试与大体积缩略图一律不进仓库。
# ---------------------------------------------------------------------------

# ① ComfyUI / Python 运行时产物
__pycache__/
*.py[cod]
*.egg-info/

# ② 本机数据（首次运行插件时会自动重建，不需要进仓库）
user_data/

# ③ 角色缩略图（约 40 MB / 2000 张）
#    不进仓库的原因：体积大、每次改动都膨胀 git 历史、图片来源有版权考量。
#    没有它插件照样能跑，角色图鉴会退回首字色块；需要时用抓图脚本自行生成。
thumbs/

# ④ 词库历史备份
presets/*.bak-*

# ⑤ 开发期资源（维护者本地使用，不对外分发）
tests/
tools/.cache_*/
tools/_sheets/
tools/_archive/
docs/_archive_v1/

# ⑥ 杂项
*.log
.DS_Store
Thumbs.db
